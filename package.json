{
  "name": "ui_app_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",

  "engines": {
        "node": "24",
        "pnpm": "<11"
    },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write \"src/static/ui_app_ts/src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/static/ui_app_ts/src/**/*.{ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.15.2",
    "classnames": "^2.5.1",
    "maplibre-gl": "^5.23.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-map-gl": "^8.1.1",
    "react-redux": "^9.2.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.15.0",
    "prettier": "^3.8.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.2.0"
  }
}
